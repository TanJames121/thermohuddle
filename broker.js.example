// ThermoHuddle broker.js EXAMPLE — copy to broker.js and edit, keep out of git!
// The app's "⚡ Connect MQTT" button fetches this file automatically.
// Restart the app (or toggle the button) after editing.

window.BROKER = {
  // MQTT-over-WebSocket URL. Use ws:// on LAN, wss:// (TLS) for internet.
  // Local pilot (mosquitto on the Pi):      ws://192.168.1.50:9001
  // Managed cloud broker (HiveMQ free tier): wss://<your-cluster>.hivemq.cloud:8884/mqtt
  url: "ws://192.168.1.50:9001",

  // Optional auth — REQUIRED if the broker is reachable from the internet
  username: "thermohuddle",
  password: "change-me",

  // Topic the Pi pipeline publishes telemetry on (must match thermohuddle_draft.py)
  topic: "thermohuddle/telemetry",

  // Live camera feed (optional). RECOMMENDED: Supabase Storage snapshot —
  // the app polls this every feed_poll_s ONLY while the feed view is open
  // and the tab is visible (~14 MB/hr per viewer).
  // feed_url: "https://<project>.supabase.co/storage/v1/object/public/frames/live.jpg",
  // feed_poll_s: 15,   // seconds between feed refreshes (default 15)
};
